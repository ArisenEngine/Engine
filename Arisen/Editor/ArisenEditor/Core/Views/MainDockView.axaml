<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
             xmlns:vm="clr-namespace:ArisenEditor.Core.Views"
             xmlns:view="clr-namespace:ArisenEditor.Core.Views"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="ArisenEditor.Core.Views.MainDockView"
             x:DataType="vm:MainEditorHostViewModel">
    <DockPanel>
        <!-- Header -->
        <Border Classes="MainHeader" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="20">
                    <!-- Logo and Title -->
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Width="24" Height="24" Background="{DynamicResource ArisenPrimaryBrush}" CornerRadius="4">
                            <!-- Icon Placeholder -->
                            <Path Fill="White" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Arisen Engine" Foreground="White" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <!-- Menus -->
                    <view:MenuItemBarView DataContext="{Binding MenuViewModel}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Header Search -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Width="250" Height="28" 
                        Background="{DynamicResource ArisenPanelDarkBrush}" 
                        BorderBrush="{DynamicResource ArisenBorderDarkBrush}" 
                        BorderThickness="1" CornerRadius="4" Margin="0,6">
                    <Grid ColumnDefinitions="Auto, *">
                        <Path Fill="#94a3b8" Data="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 1,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z" 
                              Width="12" Height="12" Margin="8,0" VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Watermark="Search components..." BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Center" FontSize="11" Text="{Binding SearchText}"/>
                    </Grid>
                </Border>

                <!-- Profile and Settings -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="ToolbarButton">
                        <Path Fill="#94a3b8" Data="M12,22A2,2 0 0,0 14,20H10A2,2 0 0,0 12,22M18,16V11C18,7.93 16.36,5.36 13.5,4.68V4A1.5,1.5 0 0,0 12,2.5A1.5,1.5 0 0,0 10.5,4V4.68C7.63,5.36 6,7.92 6,11V16L4,18V19H20V18L18,16Z" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ToolbarButton">
                        <Path Fill="#94a3b8" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.03L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.97 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.97 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.03C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.22,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.95C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.95L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" Width="14" Height="14"/>
                    </Button>
                    <Separator Width="1" Height="16" Background="{DynamicResource ArisenBorderDarkBrush}"/>
                    <Border Width="24" Height="24" CornerRadius="12" Background="#135bec" Opacity="0.2" BorderBrush="#135bec" BorderThickness="1">
                         <Path Fill="#135bec" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Toolbar -->
        <Border Classes="MainToolbar" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,0">
                <!-- Transform Tools -->
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button Classes="ToolbarButton">
                        <Path Fill="#94a3b8" Data="M10.5,9H4.5V3H10.5V9M10.5,21H4.5V15H10.5V21M19.5,9H13.5V3H19.5V9M19.5,21H13.5V15H19.5V21" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ToolbarButton" Background="{DynamicResource ArisenPrimaryBrush}" Opacity="0.1" BorderBrush="{DynamicResource ArisenPrimaryBrush}" BorderThickness="1">
                        <Path Fill="{DynamicResource ArisenPrimaryBrush}" Data="M10,21V19H6.41L10.91,14.5L9.5,13.09L5,17.59V14H3V21H10M14.5,10.91L19,6.41V10H21V3H14V5H17.59L13.09,9.5L14.5,10.91Z" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ToolbarButton">
                        <Path Fill="#94a3b8" Data="M3,3V9H5V5H9V3H3M15,3V5H19V9H21V3H15M3,15V21H9V19H5V15H3M21,15V21H15V19H19V15H21Z" Width="14" Height="14"/>
                    </Button>
                    <Separator Width="1" Height="20" Background="{DynamicResource ArisenBorderDarkBrush}" Margin="8,0"/>
                    <Button Classes="ToolbarButton">
                         <Path Fill="#94a3b8" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Width="14" Height="14"/>
                    </Button>
                    <Button Classes="ToolbarButton">
                         <Path Fill="#94a3b8" Data="M4,15V9H8V4.16L12,1.16L16,4.16V9H20V15H16V20.84L12,23.84L8,20.84V15H4M10,15V19.68L12,21.18L14,19.68V15H10M10,9V13H14V9H10M10,5.66V7H14V5.66L12,4.16L10,5.66Z" Width="14" Height="14"/>
                    </Button>
                </StackPanel>

                <!-- Transport Controls (Play/Pause/Stop) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="#181e2a" BorderBrush="{DynamicResource ArisenBorderDarkBrush}" BorderThickness="1" CornerRadius="8" Height="28">
                    <StackPanel Orientation="Horizontal" Spacing="2" Margin="2">
                        <Button Classes="ToolbarButton" Command="{Binding PlayCommand}">
                            <Path Fill="#22c55e" Data="M8,5.14V19.14L19,12.14L8,5.14Z" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="ToolbarButton" Command="{Binding PauseCommand}">
                            <Path Fill="#3b82f6" Data="M14,19H18V5H14M6,19H10V5H6V19Z" Width="14" Height="14"/>
                        </Button>
                        <Button Classes="ToolbarButton" Command="{Binding StopCommand}">
                            <Path Fill="#ef4444" Data="M18,18H6V6H18V18Z" Width="14" Height="14"/>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Layers and Build -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10">
                    <Border Background="{DynamicResource ArisenPanelDarkBrush}" BorderBrush="{DynamicResource ArisenBorderDarkBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Height="28">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="LAYERS" Foreground="#64748b" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock Text="Default" FontSize="11" VerticalAlignment="Center"/>
                            <Path Fill="#64748b" Data="M7,10L12,15L17,10H7Z" Width="10" Height="10" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button Command="{Binding BuildCommand}" Background="{DynamicResource ArisenPrimaryBrush}" Height="28" Padding="12,0" CornerRadius="4">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Fill="White" Data="M12,3L1,9L12,15L23,9L12,3M12,18L3,13V15L12,20L21,15V13L12,18Z" Width="12" Height="12" VerticalAlignment="Center"/>
                            <TextBlock Text="Build" Foreground="White" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Border Classes="MainFooter" DockPanel.Dock="Bottom">
            <Grid ColumnDefinitions="Auto, *, Auto" Margin="12,0">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="8" Height="8" Fill="{DynamicResource ArisenPrimaryBrush}"/>
                        <TextBlock Classes="StatusBarText" Text="{Binding StatusText}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Separator Width="1" Height="12" Background="{DynamicResource ArisenBorderDarkBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Classes="StatusBarText" Text="Pos: 0.0, 1.2, -5.4"/>
                        <TextBlock Classes="StatusBarText" Text="Rot: 0.0, 0.0, 0.0"/>
                    </StackPanel>
                </StackPanel>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                    <TextBlock Classes="StatusBarText" Text="AvaloniaUI 11.0.5"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Fill="#64748b" Data="M12,11L12,13L2,13L2,11L12,11M12,5L12,7L2,7L2,5L12,5M12,17L12,19L2,19L2,17L12,17M14,17L22,17L22,19L14,19L14,17M14,11L22,11L22,13L14,13L14,11M14,5L22,5L22,7L14,7L14,5Z" Width="12" Height="12" VerticalAlignment="Center"/>
                        <TextBlock Classes="StatusBarText" Text="2.4 GB / 16 GB"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Workspace -->
        <Border Padding="0">
             <dock:DockControl Layout="{Binding Layout}" Factory="{Binding Factory}" />
        </Border>
    </DockPanel>
</UserControl>
