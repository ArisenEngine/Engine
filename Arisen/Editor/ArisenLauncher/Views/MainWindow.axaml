<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArisenLauncher.ViewModels"
        xmlns:services="using:ArisenLauncher.Services"
        xmlns:models="using:ArisenLauncher.Models"
        x:Class="ArisenLauncher.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainViewModel"
        Title="Arisen Engine | Launch Hub"
        Icon="avares://ArisenLauncher/Assets/arisen-logo.ico"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#0f1117"
        Foreground="#f1f5f9"
        FontFamily="Inter, Space Grotesk">
    
    <Grid ColumnDefinitions="260, *">
        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="0,0,1,0">
            <DockPanel Margin="16">
                <!-- Branding -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0,0,0,32">
                    <Border Width="32" Height="32" Background="#135bec" CornerRadius="8">
                        <Path Fill="White" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <TextBlock Text="Arisen Engine" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Navigation -->
                <StackPanel DockPanel.Dock="Top" Spacing="4">
                    <TextBlock Text="MAIN MENU" IsVisible="True" FontSize="10" FontWeight="Bold" Foreground="#64748b" Margin="12,0,0,8"/>
                    <Button Classes="NavItemActive" Content="Projects"/>
                    <Button Classes="NavItem" Content="Learning (Coming Soon)" IsEnabled="False"/>
                    <Button Classes="NavItem" Content="Marketplace (Coming Soon)" IsEnabled="False"/>
                    <Button Classes="NavItem" Content="Templates (Coming Soon)" IsEnabled="False"/>
                </StackPanel>
                
                <!-- Bottom Profile/Settings -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="12">
                   <Border Height="1" Background="#282e39" Margin="0,0,0,12"/>
                   
                   <!-- Engine Version Selector -->
                   <ComboBox ItemsSource="{Binding Engines}" 
                             SelectedItem="{Binding SelectedEngine}"
                             Background="Transparent" BorderThickness="0"
                             HorizontalAlignment="Stretch" Margin="8,0">
                       <ComboBox.ItemTemplate>
                           <DataTemplate x:DataType="services:EngineInstance">
                               <StackPanel Orientation="Horizontal" Spacing="12">
                                   <Border Width="8" Height="8" Background="#22c55e" CornerRadius="4" VerticalAlignment="Center"/>
                                   <StackPanel>
                                       <TextBlock Text="{Binding Version}" FontSize="11" FontWeight="SemiBold"/>
                                       <TextBlock Text="{Binding InstallPath}" FontSize="9" Foreground="#64748b"/>
                                   </StackPanel>
                               </StackPanel>
                           </DataTemplate>
                       </ComboBox.ItemTemplate>
                   </ComboBox>

                   <Button Content="+ Add Engine" 
                           Command="{Binding AddEngineCommand}"
                           Classes="NavItem" Margin="12,0" FontSize="11"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *">
            <!-- Header -->
            <Border Grid.Row="0" Height="64" BorderBrush="#282e39" BorderThickness="0,0,0,1" Padding="24,0">
                <DockPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Projects" Foreground="#64748b" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock Text="/" Foreground="#64748b" VerticalAlignment="Center"/>
                        <TextBlock Text="Recent Projects" Foreground="White" FontSize="13" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="#64748b" Margin="0,0,16,0"/>
                        <Button Command="{Binding BrowseProjectCommand}"
                                Background="Transparent" BorderBrush="#282e39" BorderThickness="1" Padding="16,8" CornerRadius="8">
                            <TextBlock Text="Add Existing" FontSize="13" Foreground="#94a3b8"/>
                        </Button>
                        <Button Command="{Binding NewProjectCommand}"
                                Background="#135bec" Foreground="White" Padding="16,8" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="+" FontWeight="Bold"/>
                                <TextBlock Text="New Project" FontWeight="Bold" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Scrollable Content -->
            <ScrollViewer Grid.Row="1">
                <Grid RowDefinitions="Auto, 32, Auto, 32, Auto" Margin="48">
                    <StackPanel Grid.Row="0" Spacing="8">
                        <TextBlock Text="My Projects" FontSize="32" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Manage your active workspace. Choose a project to start editing."
                                   Foreground="#64748b" FontSize="14"/>
                    </StackPanel>

                    <!-- Projects Grid -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding RecentProjects}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LauncherProjectMetadata">
                                <Border Background="Transparent" Padding="0" Margin="0,0,24,24" Width="320">
                                    <Border Background="#1a1e26" CornerRadius="12" BorderBrush="#282e39" BorderThickness="1" ClipToBounds="True">
                                        <StackPanel>
                                            <!-- U4: Improved Thumbnail with Gradient -->
                                            <Border Height="140" CornerRadius="12,12,0,0">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                                        <GradientStop Offset="0" Color="#1e293b"/>
                                                        <GradientStop Offset="1" Color="#0f172a"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Viewbox Stretch="Uniform" Margin="40">
                                                    <Path Fill="#135bec" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Opacity="0.4"/>
                                                </Viewbox>
                                            </Border>
                                            
                                            <StackPanel Margin="16">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="White" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding ProjectPath}" FontSize="11" Foreground="#64748b" Margin="0,4,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                                
                                                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,16">
                                                    <TextBlock Grid.Column="0" Text="Arisen Project" FontSize="11" Foreground="#135bec" FontWeight="SemiBold"/>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding LastModified, StringFormat='{}{0:MM/dd/yyyy}'}" FontSize="11" Foreground="#64748b"/>
                                                        <Button Background="Transparent" Padding="2"
                                                                Command="{Binding #Root.((vm:MainViewModel)DataContext).RemoveFromRecentCommand}"
                                                                CommandParameter="{Binding}" ToolTip.Tip="Remove from recent">
                                                            <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z" 
                                                                  Fill="#64748b" Width="12" Height="12" Stretch="Uniform"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                
                                                <!-- U5: Better Button Sizing and Labels -->
                                                <Grid ColumnDefinitions="*, 8, *">
                                                    <Button Grid.Column="0" Content="Launch Editor" Classes="Primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).LaunchProjectCommand}" 
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="2" Content="Packages" Classes="Secondary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                                            Command="{Binding #Root.((vm:MainViewModel)DataContext).ManagePackagesCommand}" 
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Bottom Action Cards -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="16">
                        <!-- Create New Card -->
                        <Button Width="300" Height="180" Background="Transparent" Padding="0"
                                Command="{Binding NewProjectCommand}">
                            <Border Background="#0f1117" CornerRadius="12" BorderBrush="#282e39" BorderThickness="2">
                               <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                   <Border Background="#282e39" Width="48" Height="48" CornerRadius="24">
                                       <TextBlock Text="+" Foreground="#64748b" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                   </Border>
                                   <TextBlock Text="Create New Project" FontWeight="Bold" HorizontalAlignment="Center"/>
                               </StackPanel>
                            </Border>
                        </Button>

                        <!-- Add Existing Card -->
                        <Button Width="300" Height="180" Background="Transparent" Padding="0"
                                Command="{Binding BrowseProjectCommand}">
                            <Border Background="#0f1117" CornerRadius="12" BorderBrush="#282e39" BorderThickness="2">
                               <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12">
                                   <Border Background="#282e39" Width="48" Height="48" CornerRadius="24">
                                       <!-- A simple folder-like or plus icon -->
                                       <Path Fill="#64748b" Data="M19,20H4C2.89,20 2,19.1 2,18V6C2,4.89 2.89,4 4,4H10L12,6H19A2,2 0 0,1 21,8H21L4,8V18L6.14,10.7C6.4,9.8 7.23,9.2 8.17,9.2H23.5L21.22,17.75C20.93,18.84 19.95,19.6 18.83,19.6" Stretch="Uniform" Width="24" Height="24" Margin="2,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                   </Border>
                                   <TextBlock Text="Add Existing Project" FontWeight="Bold" HorizontalAlignment="Center"/>
                               </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>

    <Window.Styles>
        <Style Selector="Button.NavItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.NavItem:hover">
            <Setter Property="Background" Value="#282e39"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.NavItemActive">
            <Setter Property="Background" Value="#135bec20"/>
            <Setter Property="Foreground" Value="#135bec"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        
        <Style Selector="Button.Primary">
            <Setter Property="Background" Value="#135bec"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Secondary">
            <Setter Property="Background" Value="#282e39"/>
            <Setter Property="Foreground" Value="#94a3b8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.Secondary:hover">
            <Setter Property="Background" Value="#323945"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Styles>
</Window>
