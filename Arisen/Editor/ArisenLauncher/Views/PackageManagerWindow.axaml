<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ArisenLauncher.ViewModels"
        x:Class="ArisenLauncher.Views.PackageManagerWindow"
        x:DataType="vm:PackageManagerViewModel"
        x:Name="PackageManagerWindowRoot"
        Title="Project Package Manager" Width="850" Height="680" WindowStartupLocation="CenterOwner"
        Icon="avares://ArisenLauncher/Assets/arisen-logo.ico"
        Background="#0f1117"
        Foreground="#f1f5f9"
        FontFamily="Inter, Space Grotesk">
    
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <Border Grid.Row="0" Height="64" BorderBrush="#282e39" BorderThickness="0,0,0,1" Padding="24,0" Background="#1a1e26">
            <DockPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="32" Height="32" Background="#135bec" CornerRadius="8">
                        <Path Fill="White" Data="M12,2L4.5,20.29L5.21,21L12,18L18.79,21L19.5,20.29L12,2Z" Stretch="Uniform" Margin="6"/>
                    </Border>
                    <TextBlock Text="{Binding Manifest.Name, StringFormat='{}Packages / {0}'}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content -->
        <TabControl Grid.Row="1" Margin="24,12,24,24" Background="Transparent">
            <!-- Packages Tab -->
            <!-- Packages Tab -->
            <TabItem Header="Installed Packages" FontSize="16" FontWeight="Bold">
                <Grid RowDefinitions="Auto, *" Margin="0,16,0,0">
                    <!-- Top Toolbar -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, 300" Margin="0,0,0,16">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <Button Content="+ Create Local" Command="{Binding BeginCreatePackageCommand}" 
                                    Background="#135bec" Foreground="White" Padding="12,6" CornerRadius="6" FontWeight="SemiBold"/>
                            <Button Content="Import Local..." Command="{Binding AddLocalPackageCommand}" 
                                    Background="Transparent" BorderBrush="#282e39" BorderThickness="1" Foreground="#94a3b8" Padding="12,6" CornerRadius="6"/>
                            <Button Content="Add Remote..." Command="{Binding AddPackageCommand}" 
                                    Background="Transparent" BorderBrush="#282e39" BorderThickness="1" Foreground="#94a3b8" Padding="12,6" CornerRadius="6"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <ComboBox SelectedIndex="{Binding SortMode}" MaxWidth="120" Background="#0f1117" BorderBrush="#282e39" Foreground="White" VerticalAlignment="Center" CornerRadius="6">
                                <ComboBoxItem>Sort by Name</ComboBoxItem>
                                <ComboBoxItem>Sort by ID</ComboBoxItem>
                            </ComboBox>
                            <TextBox Text="{Binding SearchText}" Watermark="Search packages..." Background="#0f1117" BorderBrush="#282e39" Foreground="White" CornerRadius="6" Padding="8,6" VerticalAlignment="Center" Width="180"/>
                        </StackPanel>
                    </Grid>

                    <!-- Main Area -->
                    <Grid Grid.Row="1">
                        <!-- Create Package Wizard Panel -->
                        <Border IsVisible="{Binding IsCreatingPackage}" ZIndex="10" Background="#13151c" CornerRadius="8" BorderBrush="#282e39" BorderThickness="1" Padding="24" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <StackPanel Spacing="16">
                                <TextBlock Text="Create New Local Package" FontSize="18" FontWeight="Bold" Foreground="White"/>
                                <TextBlock Text="Scaffolds a new package explicitly inside this project's Local/ directory." Foreground="#64748b" FontSize="12" Margin="0,-8,0,0"/>

                                <!-- Validation Error -->
                                <Border IsVisible="{Binding HasCreatePackageError}" Background="#ef444420" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="6" Padding="12">
                                    <TextBlock Text="{Binding CreatePackageError}" Foreground="#ef4444" FontWeight="Bold" TextWrapping="Wrap" FontSize="12"/>
                                </Border>

                                <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto" Margin="0,8,0,0">
                                    <!-- Left Column -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,12,12">
                                        <TextBlock Text="Package ID (e.g. com.mycompany.inventory)" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding NewPackageId}" Background="#0f1117" BorderBrush="#282e39" Foreground="White"/>
                                    </StackPanel>
                                    
                                    <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,0,12,12">
                                        <TextBlock Text="Package Name" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding NewPackageName}" Background="#0f1117" BorderBrush="#282e39" Foreground="White"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="2" Grid.Column="0" Spacing="6" Margin="0,0,12,12">
                                        <TextBlock Text="Version" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding NewPackageVersion}" Background="#0f1117" BorderBrush="#282e39" Foreground="White"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="3" Grid.Column="0" Spacing="6" Margin="0,0,12,0">
                                        <TextBlock Text="Package Type" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <ComboBox SelectedItem="{Binding NewPackageType}" ItemsSource="{Binding AvailablePackageTypes}" Background="#0f1117" BorderBrush="#282e39" Foreground="White" HorizontalAlignment="Stretch" />
                                    </StackPanel>

                                    <StackPanel Grid.Row="4" Grid.Column="0" Spacing="6" Margin="0,12,12,12">
                                        <TextBlock Text="Assembly Entry (Class Name)" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <TextBox Text="{Binding NewPackageAssemblyEntry}" Background="#0f1117" BorderBrush="#282e39" Foreground="White" Watermark="e.g. ArisenEngine.Core.PackageEntry"/>
                                    </StackPanel>

                                    <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Spacing="6" Margin="0,12,0,0">
                                        <TextBlock Text="Service Capabilities Matrix" FontSize="12" Foreground="#94a3b8" FontWeight="SemiBold"/>
                                        <ListBox ItemsSource="{Binding NewPackageServices}" Background="#0f1117" BorderBrush="#282e39" BorderThickness="1" CornerRadius="4" Height="140">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ColumnDefinitions="*, Auto, Auto" Margin="4,2">
                                                        <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" ToolTip.Tip="{Binding ContractName}" VerticalAlignment="Center" Foreground="#94a3b8"/>
                                                        <CheckBox Grid.Column="1" Content="Provides" IsChecked="{Binding IsProvided}" Margin="16,0,8,0" Foreground="#22c55e" FontWeight="SemiBold"/>
                                                        <CheckBox Grid.Column="2" Content="Requires" IsChecked="{Binding IsRequired}" Margin="8,0" Foreground="#ef4444" FontWeight="SemiBold"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12" Margin="0,16,0,0">
                                    <Button Content="Cancel" Command="{Binding CancelCreatePackageCommand}" Background="Transparent" BorderBrush="#282e39" BorderThickness="1" Foreground="#94a3b8" Padding="20,8" CornerRadius="6"/>
                                    <Button Content="Create Package" Command="{Binding ConfirmCreatePackageCommand}" Background="#22c55e" Foreground="White" FontWeight="Bold" Padding="20,8" CornerRadius="6"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Grid ColumnDefinitions="280, 1, *" IsVisible="{Binding !IsCreatingPackage}">
                            
                            <!-- Left Panel: Package List -->
                            <Border Grid.Column="0" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="1" CornerRadius="8">
                                <Grid RowDefinitions="Auto, *">
                                    <!-- Error Banner (Global Verification) -->
                                    <Border Grid.Row="0" IsVisible="{Binding HasVerificationError}" 
                                            Background="#ef444420" BorderBrush="#ef4444" BorderThickness="0,0,0,1" Padding="12,12">
                                        <TextBlock Text="{Binding VerificationError}" Foreground="#ef4444" FontWeight="Bold" TextWrapping="Wrap" FontSize="12"/>
                                    </Border>

                                    <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPackages}" SelectedItem="{Binding SelectedPackage}" Background="Transparent" 
                                             BorderThickness="0" CornerRadius="8" Padding="0" VerticalAlignment="Stretch">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:PackageRequirementViewModel">
                                                <Grid ColumnDefinitions="*, Auto" Margin="8,4">
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="14" Foreground="White" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{Binding Id}" FontSize="11" Foreground="#64748b" TextTrimming="CharacterEllipsis" Margin="0,0,0,2"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="10" Foreground="#475569" TextTrimming="CharacterEllipsis" IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="{Binding Version}" FontSize="12" Foreground="#94a3b8" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                    
                                                    <!-- Badges -->
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <Border IsVisible="{Binding IsLocal}" Background="#135bec20" BorderBrush="#135bec" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Local" FontSize="10" Foreground="#135bec" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding IsUnresolved}" Background="#eab30820" BorderBrush="#eab308" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Missing" FontSize="10" Foreground="#eab308" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border IsVisible="{Binding IsRemote}" Background="#22c55e20" BorderBrush="#22c55e" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="Remote" FontSize="10" Foreground="#22c55e" FontWeight="Bold"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.Styles>
                                            <Style Selector="ListBoxItem">
                                                <Setter Property="Padding" Value="8"/>
                                                <Setter Property="Margin" Value="0,2"/>
                                            </Style>
                                        </ListBox.Styles>
                                    </ListBox>
                                </Grid>
                            </Border>

                            <GridSplitter Grid.Column="1" Background="Transparent" ResizeDirection="Columns" Margin="-2,0,2,0"/>

                            <!-- Right Panel: Package Details -->
                            <Border Grid.Column="2" Background="#13151c" BorderBrush="#282e39" BorderThickness="1" CornerRadius="8" Margin="8,0,0,0">
                                <!-- Show when package is selected -->
                                <Panel>
                                    <TextBlock Text="Select a package to view details." Foreground="#64748b" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding SelectedPackage, Converter={x:Static ObjectConverters.IsNull}}"/>
                                    
                                    <ScrollViewer IsVisible="{Binding SelectedPackage, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <StackPanel DataContext="{Binding SelectedPackage}" x:DataType="vm:PackageRequirementViewModel" Margin="24" Spacing="24">
                                            
                                            <!-- Header -->
                                            <Grid ColumnDefinitions="*, Auto">
                                                <StackPanel Grid.Column="0" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Black" FontSize="26" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Id}" FontSize="13" Foreground="#64748b" Margin="0,-4,0,0"/>
                                                    
                                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,8,0,0">
                                                        <Border Background="#282e39" CornerRadius="6" Padding="10,4">
                                                            <TextBlock Text="{Binding Version, StringFormat='v{0}'}" FontSize="12" Foreground="White" FontWeight="Bold"/>
                                                        </Border>
                                                        <Border Background="#135bec20" BorderBrush="#135bec" BorderThickness="1" CornerRadius="6" Padding="10,4">
                                                            <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#135bec" FontWeight="Bold"/>
                                                        </Border>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <Path Fill="#64748b" Data="M12,17L12,10M12,21L12,21M12,3L12,3M3.1,12C3.1,12 3.1,12 3.1,12" Stretch="Uniform" Width="12" Height="12"/>
                                                            <TextBlock Text="{Binding EngineVersion, StringFormat='Engine: {0}'}" FontSize="12" Foreground="#94a3b8"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons Area -->
                                                <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                                                    <Button Content="Remove" Command="{Binding ParentContext.RemovePackageCommand}" CommandParameter="{Binding}" 
                                                            Background="#ef444420" Foreground="#ef4444" BorderBrush="#ef4444" BorderThickness="1" Padding="16,8" CornerRadius="6" FontWeight="Bold" Cursor="Hand" Width="120" HorizontalContentAlignment="Center"/>
                                                    <Button Content="Save Package" Command="{Binding ParentContext.SaveLocalPackageCommand}" CommandParameter="{Binding}" 
                                                            IsVisible="{Binding IsLocal}"
                                                            Background="#22c55e" Foreground="White" Padding="16,8" CornerRadius="6" FontWeight="Bold" Cursor="Hand" Width="120" HorizontalContentAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <Separator Background="#282e39"/>

                                            <!-- Metadata Sections -->
                                            <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" Margin="0,0,0,24">
                                                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8" Margin="0,0,12,12">
                                                    <TextBlock Text="DISPLAY NAME" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding DisplayName}" IsEnabled="{Binding IsLocal}" Background="#0f1117" BorderBrush="#282e39" Foreground="White" CornerRadius="4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8" Margin="12,0,0,12">
                                                    <TextBlock Text="VERSION" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding Version}" IsEnabled="{Binding IsLocal}" Background="#0f1117" BorderBrush="#282e39" Foreground="White" CornerRadius="4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,12,12,0">
                                                    <TextBlock Text="AUTHOR" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                    <TextBox Text="{Binding Author}" IsEnabled="{Binding IsLocal}" Background="#0f1117" BorderBrush="#282e39" Foreground="White" CornerRadius="4"/>
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8" Margin="12,12,0,0">
                                                    <TextBlock Text="STATUS" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                    <TextBlock IsVisible="{Binding IsLocal}" Text="Local Source (Mutable)" Foreground="#135bec" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock IsVisible="{Binding IsRemote}" Text="Remote Registry (Read-Only)" Foreground="#22c55e" FontSize="13" VerticalAlignment="Center"/>
                                                    <TextBlock IsVisible="{Binding IsUnresolved}" Text="Unresolved / Missing" Foreground="#ef4444" FontSize="13" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel Spacing="8">
                                                <TextBlock Text="DESCRIPTION" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                <TextBox Text="{Binding Description}" IsEnabled="{Binding IsLocal}" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Background="#0f1117" BorderBrush="#282e39" Foreground="White" CornerRadius="4"/>
                                            </StackPanel>

                                            <!-- Dependencies Section -->
                                            <StackPanel Spacing="16">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Left" Text="Dependencies" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                                    <Button DockPanel.Dock="Right" Content="+ Add" IsVisible="{Binding IsLocal}" Command="{Binding ParentContext.AddDependencyCommand}" CommandParameter="{Binding}" Padding="8,2" FontSize="12" Background="#135bec" Foreground="White" CornerRadius="4"/>
                                                </DockPanel>
                                                
                                                <Border Background="#1a1e26" CornerRadius="8" BorderBrush="#282e39" BorderThickness="1" MinHeight="40">
                                                    <ItemsControl ItemsSource="{Binding Dependencies}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="vm:DependencyViewModel">
                                                                <Border BorderBrush="#282e39" BorderThickness="0,0,0,1" Padding="12,8">
                                                                    <Grid ColumnDefinitions="*, 80, Auto">
                                                                        <TextBox Grid.Column="0" Text="{Binding Id}" IsEnabled="{Binding $parent[StackPanel].((vm:PackageRequirementViewModel)DataContext).IsLocal}" Background="Transparent" BorderThickness="0" Foreground="White" Padding="0"/>
                                                                        <TextBox Grid.Column="1" Text="{Binding Version}" IsEnabled="{Binding $parent[StackPanel].((vm:PackageRequirementViewModel)DataContext).IsLocal}" Background="Transparent" BorderThickness="0" Foreground="#94a3b8" HorizontalContentAlignment="Right" Padding="0,0,8,0"/>
                                                                        <Button Grid.Column="2" Content="✕" IsVisible="{Binding $parent[StackPanel].((vm:PackageRequirementViewModel)DataContext).IsLocal}" 
                                                                                Command="{Binding $parent[Window].((vm:PackageManagerViewModel)DataContext).RemoveDependencyCommand}" CommandParameter="{Binding}"
                                                                                Background="Transparent" Foreground="#ef4444" Padding="4,2"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>

                                            <!-- Advanced Configuration (Expander) -->
                                            <Expander Header="Advanced Configuration / Build Metadata" Foreground="#94a3b8" Background="#1a1e26" BorderBrush="#282e39" CornerRadius="8" Padding="0">
                                                <StackPanel Spacing="16" Margin="16">
                                                    <Border Background="#ef444410" BorderBrush="#ef444440" BorderThickness="1" CornerRadius="6" Padding="12">                                                        <TextBlock Text="Note: These fields are managed by ArisenBuildTool and are read-only in the Launcher to prevent build desync." 
                                                                    Foreground="#ef4444" FontSize="11" TextWrapping="Wrap" FontWeight="SemiBold"/>
                                                    </Border>

                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Assembly DLL Name" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                        <TextBox Text="{Binding AssemblyEntry}" IsEnabled="False" Opacity="0.7" Background="#0f1117" BorderBrush="#282e39" Foreground="White" Watermark="e.g. MyPackage.dll"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="Entry Point Class" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                        <TextBox Text="{Binding EntryClass}" IsEnabled="False" Opacity="0.7" Background="#0f1117" BorderBrush="#282e39" Foreground="White" Watermark="e.g. MyNamespace.MyPackageEntry"/>
                                                    </StackPanel>

                                                    <StackPanel Spacing="6" IsVisible="{Binding NativeRuntimesDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                        <TextBlock Text="Native Runtimes" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                        <TextBox Text="{Binding NativeRuntimesDisplay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="100" Background="#0f1117" BorderBrush="#282e39" Foreground="#22c55e" CornerRadius="4"/>
                                                    </StackPanel>


                                                    <!-- Services Matrix (Display Only) -->
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="Injected Services" FontSize="11" Foreground="#64748b" FontWeight="Bold"/>
                                                        <Border Background="#0f1117" BorderBrush="#282e39" BorderThickness="1" CornerRadius="6" Padding="12">
                                                            <Grid>
                                                                <ListBox ItemsSource="{Binding EditableServices}" Background="Transparent" Height="150" BorderThickness="0" CornerRadius="0">
                                                                    <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Grid ColumnDefinitions="*, Auto, Auto" Margin="0,4">
                                                                                <TextBlock Grid.Column="0" Text="{Binding FriendlyName}" ToolTip.Tip="{Binding ContractName}" VerticalAlignment="Center" Foreground="#94a3b8" FontSize="12"/>
                                                                                <Border Grid.Column="1" IsVisible="{Binding IsProvided}" Background="#22c55e20" CornerRadius="4" Padding="6,2" Margin="8,0">
                                                                                    <TextBlock Text="Provides" Foreground="#22c55e" FontSize="10" FontWeight="Bold"/>
                                                                                </Border>
                                                                                <Border Grid.Column="2" IsVisible="{Binding IsRequired}" Background="#ef444420" CornerRadius="4" Padding="6,2">
                                                                                    <TextBlock Text="Requires" Foreground="#ef4444" FontSize="10" FontWeight="Bold"/>
                                                                                </Border>
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ListBox.ItemTemplate>
                                                                </ListBox>
                                                                <TextBlock Text="Enable 'View Services' to scan contracts." IsVisible="{Binding !HasEditableServicesLoaded}" Foreground="#64748b" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                            </Grid>
                                                        </Border>
                                                        <CheckBox Content="View Service Mapping" IsChecked="{Binding IsEditingServices}" IsEnabled="{Binding IsLocal}" Foreground="#94a3b8" Margin="0,4,0,0" FontSize="12"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Expander>

                                            <!-- Status Banner (Missing) -->
                                            <Border IsVisible="{Binding IsUnresolved}" Background="#eab30810" BorderBrush="#eab308" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,8,0,0">
                                                <StackPanel Spacing="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Path Fill="#eab308" Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16" Stretch="Uniform" Width="18" Height="18"/>
                                                        <TextBlock Text="{Binding UnresolvedMessage}" Foreground="#eab308" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                                        <TextBox Grid.Column="0" Text="{Binding Url}" VerticalContentAlignment="Center" Watermark="Enter Remote URL or Browse..." Background="#0f1117" BorderBrush="#282e39" Foreground="#94a3b8" Padding="10,8" Margin="0,0,8,0" CornerRadius="4"/>
                                                        <Button Grid.Column="1" Content="Browse..." Command="{Binding ParentContext.BrowseResolvePackageCommand}" CommandParameter="{Binding}" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="1" Foreground="White" FontWeight="Bold" Padding="16,8" Margin="0,0,8,0" CornerRadius="4"/>
                                                        <Button Grid.Column="2" Content="Confirm URL" Command="{Binding ParentContext.ConfirmResolvePackageCommand}" CommandParameter="{Binding}" Background="#eab308" Foreground="#0f1117" FontWeight="Bold" Padding="16,8" CornerRadius="4"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>


                                        </StackPanel>
                                    </ScrollViewer>
                                </Panel>
                            </Border>

                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>
            
            <!-- Profiles Tab -->
            <TabItem Header="Workspace Profiles" FontSize="16" FontWeight="Bold">
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Define entry-point profiles for booting the Engine Kernel (e.g. Development, Production, DedicatedServer)." Foreground="#64748b" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Button Content="+ Add Custom Profile" Command="{Binding AddProfileCommand}" Background="#135bec" Foreground="White" Padding="16,8" CornerRadius="6" FontWeight="SemiBold"/>
                        
                        <ItemsControl ItemsSource="{Binding Profiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="16"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:WorkspaceProfileViewModel">
                                    <Border Background="#1a1e26" CornerRadius="8" BorderBrush="#282e39" BorderThickness="1" Padding="16">
                                        <StackPanel Spacing="12">
                                            <Grid ColumnDefinitions="*, Auto">
                                                <TextBox Grid.Column="0" Text="{Binding Name}" Background="#0f1117" BorderBrush="#282e39" FontWeight="Bold" Foreground="White"/>
                                                <Button Grid.Column="1" Content="Delete" Command="{Binding #PackageManagerWindowRoot.((vm:PackageManagerViewModel)DataContext).RemoveProfileCommand}" CommandParameter="{Binding}" Background="Transparent" Foreground="#ef4444" Margin="8,0,0,0"/>
                                            </Grid>

                                            <CheckBox Content="Engine Editor Mode (Enable Native Log Callbacks)" 
                                                      IsChecked="{Binding IsEditor}" 
                                                      Foreground="#94a3b8" FontSize="12" Margin="0,-4,0,0"/>
                                            
                                            <TextBlock Text="Profile Packages:" Foreground="#94a3b8" FontSize="12"/>
                                            <ItemsControl ItemsSource="{Binding PackageOptions}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Spacing="8"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="vm:ProfilePackageOptionViewModel">
                                                        <Border Background="#0f1117" BorderBrush="#282e39" BorderThickness="1" CornerRadius="6" Padding="10">
                                                            <Grid ColumnDefinitions="Auto, *, Auto">
                                                                <CheckBox Grid.Column="0"
                                                                          IsChecked="{Binding IsEnabled}"
                                                                          Command="{Binding #PackageManagerWindowRoot.((vm:PackageManagerViewModel)DataContext).SyncProfilePackagesCommand}"
                                                                          CommandParameter="{Binding $parent[ItemsControl].((vm:WorkspaceProfileViewModel)DataContext)}"
                                                                          VerticalAlignment="Center"
                                                                          Margin="0,0,12,0"/>
                                                                <StackPanel Grid.Column="1" Spacing="2">
                                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" FontSize="13"/>
                                                                    <TextBlock Text="{Binding Id}" Foreground="#64748b" FontSize="11" FontFamily="Consolas, monospace"/>
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                    <Border Background="#135bec20" BorderBrush="#135bec" BorderThickness="1" CornerRadius="4" Padding="6,2">
                                                                        <TextBlock Text="{Binding Type}" Foreground="#60a5fa" FontSize="10" FontWeight="Bold"/>
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Foreground="#94a3b8" FontSize="11" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Package Graph Tab -->
            <TabItem Header="Package Graph" FontSize="16" FontWeight="Bold">
                <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, *" Margin="0,16,0,0">
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, Auto, Auto, *" Margin="0,0,0,16">
                        <ComboBox Grid.Column="0"
                                  ItemsSource="{Binding GraphProfiles}"
                                  SelectedItem="{Binding SelectedGraphProfile}"
                                  Width="180"
                                  Background="#0f1117"
                                  BorderBrush="#282e39"
                                  Foreground="White"
                                  CornerRadius="6"/>
                        <Button Grid.Column="1"
                                Content="Validate Profile"
                                Command="{Binding ValidateProfileCommand}"
                                Background="#0f1117"
                                BorderBrush="#282e39"
                                BorderThickness="1"
                                Foreground="#94a3b8"
                                Padding="16,8"
                                CornerRadius="6"
                                FontWeight="SemiBold"
                                Margin="12,0,0,0"/>
                        <Button Grid.Column="2"
                                Content="Refresh Graph"
                                Command="{Binding RefreshPackageGraphCommand}"
                                Background="#135bec"
                                Foreground="White"
                                Padding="16,8"
                                CornerRadius="6"
                                FontWeight="SemiBold"
                                Margin="12,0,0,0"/>
                        <Button Grid.Column="3"
                                Content="Regenerate Projects"
                                Command="{Binding RegenerateProjectFilesCommand}"
                                Background="#22c55e"
                                Foreground="White"
                                Padding="16,8"
                                CornerRadius="6"
                                FontWeight="SemiBold"
                                Margin="12,0,0,0"/>
                        <TextBlock Grid.Column="4"
                                   Text="{Binding GraphStatus}"
                                   Foreground="#94a3b8"
                                   FontSize="13"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="16,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="1"
                            IsVisible="{Binding HasValidationStatus}"
                            Background="#22c55e20"
                            BorderBrush="#22c55e"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding ValidationStatus}"
                                   Foreground="#22c55e"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="2"
                            IsVisible="{Binding HasGenerateStatus}"
                            Background="#22c55e20"
                            BorderBrush="#22c55e"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding GenerateStatus}"
                                   Foreground="#22c55e"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="3"
                            IsVisible="{Binding HasValidationError}"
                            Background="#ef444420"
                            BorderBrush="#ef4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding ValidationError}"
                                   Foreground="#ef4444"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="4"
                            IsVisible="{Binding HasGraphError}"
                            Background="#ef444420"
                            BorderBrush="#ef4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding GraphError}"
                                   Foreground="#ef4444"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border Grid.Row="5"
                            IsVisible="{Binding HasGenerateError}"
                            Background="#ef444420"
                            BorderBrush="#ef4444"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,16">
                        <TextBlock Text="{Binding GenerateError}"
                                   Foreground="#ef4444"
                                   FontFamily="Consolas, monospace"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Grid Grid.Row="6" ColumnDefinitions="*, 16, *">
                        <Border Grid.Column="0" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="1" CornerRadius="8">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" BorderBrush="#282e39" BorderThickness="0,0,0,1" Padding="12">
                                    <TextBlock Text="Topological Order" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Border>
                                <Grid Grid.Row="1">
                                    <ListBox ItemsSource="{Binding PackageGraphPackages}" Background="Transparent" BorderThickness="0" Padding="8">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate DataType="vm:PackageGraphPackageViewModel">
                                                <Border Background="#13151c" BorderBrush="#282e39" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="42, *">
                                                        <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14" Background="#282e39" VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding Order}" Foreground="#94a3b8" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
                                                        </Border>
                                                        <StackPanel Grid.Column="1" Spacing="4">
                                                            <Grid ColumnDefinitions="*, Auto">
                                                                <TextBlock Grid.Column="0" Text="{Binding Id}" Foreground="White" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                                <Border Grid.Column="1" Background="#135bec20" BorderBrush="#135bec" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,0,0">
                                                                    <TextBlock Text="{Binding Type}" Foreground="#60a5fa" FontSize="10" FontWeight="Bold"/>
                                                                </Border>
                                                            </Grid>
                                                            <TextBlock Text="{Binding DependenciesDisplay, StringFormat='Deps: {0}'}" Foreground="#94a3b8" FontSize="11" TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Path}" Foreground="#64748b" FontSize="10" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Refresh the selected profile to inspect the resolved package order."
                                               IsVisible="{Binding !HasGraphResult}"
                                               Foreground="#64748b"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="1" CornerRadius="8">
                            <Grid RowDefinitions="Auto, *">
                                <Border Grid.Row="0" BorderBrush="#282e39" BorderThickness="0,0,0,1" Padding="12">
                                    <TextBlock Text="Dependency Edges" Foreground="White" FontWeight="Bold" FontSize="14"/>
                                </Border>
                                <ListBox Grid.Row="1" ItemsSource="{Binding PackageGraphEdges}" Background="Transparent" BorderThickness="0" Padding="8">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="vm:PackageGraphEdgeViewModel">
                                            <Border Background="#13151c" BorderBrush="#282e39" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="*, Auto, *" RowDefinitions="Auto, Auto">
                                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding From}" Foreground="White" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="->" Foreground="#94a3b8" FontWeight="Bold" Margin="10,0"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding To}" Foreground="#60a5fa" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Version, StringFormat='Version: {0}'}" Foreground="#64748b" FontSize="11" Margin="0,6,0,0"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Service Contracts Tab -->
            <TabItem Header="Service Dashboard" FontSize="16" FontWeight="Bold">
                <ScrollViewer Margin="0,16,0,0">
                    <StackPanel Spacing="24">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Automated Data-Driven Systems Map" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="This dashboard dynamically reflects loaded C# contracts and cross-references them against all package.json requirements." Foreground="#64748b" FontSize="14" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <ItemsControl ItemsSource="{Binding Capabilities}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="12"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ServiceCapabilityViewModel">
                                    <Border Background="{Binding BackgroundColor}" CornerRadius="8" BorderBrush="#282e39" BorderThickness="1" Padding="16">
                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                            
                                            <!-- Status Icon -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#282e39" Margin="0,0,16,0" VerticalAlignment="Center">
                                                <Panel>
                                                    <TextBlock Text="✓" Foreground="#22c55e" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsProvided}" />
                                                    <TextBlock Text="!" Foreground="#ef4444" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding IsNotSatisfied}" />
                                                </Panel>
                                            </Border>
                                            
                                            <!-- Info -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FriendlyName}" FontWeight="Bold" FontSize="16" Foreground="White" Margin="0,0,0,4"/>
                                                <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#94a3b8" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                <TextBlock Text="{Binding ContractName}" FontSize="11" Foreground="#64748b" FontFamily="Consolas, monospace" />
                                            </StackPanel>
                                            
                                            <!-- Mapping Details -->
                                            <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsRequired}">
                                                    <TextBlock Text="Required By:" FontSize="12" Foreground="#94a3b8" Width="80"/>
                                                    <ItemsControl ItemsSource="{Binding RequiringPackages}">
                                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="#ef4444" FontWeight="Bold" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" IsVisible="{Binding IsProvided}">
                                                    <TextBlock Text="Provided By:" FontSize="12" Foreground="#94a3b8" Width="80"/>
                                                    <ItemsControl ItemsSource="{Binding ProvidingPackages}">
                                                        <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontSize="12" Foreground="#22c55e" FontWeight="Bold" /></DataTemplate></ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
        </TabControl>

        <!-- Footer -->
        <Border Grid.Row="2" Background="#1a1e26" BorderBrush="#282e39" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
                <Button Content="Close" Command="{Binding CloseCommand}" Background="Transparent" BorderBrush="#282e39" BorderThickness="1" Foreground="#94a3b8" Padding="24,10" CornerRadius="6"/>
                <Button Content="Save Manifest" Command="{Binding SaveManifestCommand}" Click="SaveButton_Click" Background="#22c55e" Foreground="White" Padding="24,10" CornerRadius="6" FontWeight="Bold"/>
            </StackPanel>
        </Border>


        <!-- Loading Overlay -->
        <Border Grid.Row="0" Grid.RowSpan="3" Background="#cc0f1117" IsVisible="{Binding IsLoading}" ZIndex="99">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="24">
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Foreground="#135bec" Background="#282e39"/>
                <TextBlock Text="Loading Package Manifests..." Foreground="#94a3b8" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
