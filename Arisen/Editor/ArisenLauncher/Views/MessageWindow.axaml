<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ArisenLauncher.Views.MessageWindow"
        Title="Arisen Launcher" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Topmost="True">

    <Border Background="#1a1e26" BorderBrush="#282e39" BorderThickness="1" CornerRadius="12" Padding="32" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <StackPanel Spacing="24">
            <StackPanel Spacing="8" HorizontalAlignment="Center">
                <Border Width="48" Height="48" Background="#eab30820" BorderBrush="#eab308" BorderThickness="1" CornerRadius="24" HorizontalAlignment="Center">
                    <Path Fill="#eab308" Data="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16" Stretch="Uniform" Margin="12"/>
                </Border>
                <TextBlock x:Name="TitleText" Text="Warning" FontSize="20" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock x:Name="MessageText" Text="Message goes here" Foreground="#94a3b8" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>

            <Button Content="OK" Click="OnCloseClick" 
                    Background="#135bec" Foreground="White" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="12" CornerRadius="8" FontWeight="Bold"/>
        </StackPanel>
    </Border>
</Window>
