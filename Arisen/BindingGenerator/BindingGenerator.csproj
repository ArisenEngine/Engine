<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>BindingGenerator</AssemblyName>
        <RootNamespace>BindingGenerator</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath></PropertyGroup>

    <ItemGroup>
      <PackageReference Include="CppSharp" Version="1.1.5.3168" />
    </ItemGroup>

<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
<OutputPath>..\Projects\Visual Studio\Editor\Outputs\Debug\</OutputPath>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
<OutputPath>..\Projects\Visual Studio\Editor\Outputs\Release\</OutputPath>
</PropertyGroup>
</Project>