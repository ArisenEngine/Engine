{
  "id": "com.arisen.packagegame",
  "name": "PackageGame",
  "version": "1.0.0",
  "layer": "user",
  "description": "game assembly",
  "type": "managed",
  "entry": {
    "assembly": "Com.Arisen.Packagegame.dll",
    "class": "PackageGame.GameLogicPackage"
  },
  "services": {
    "requires": [
      {
        "interface": "ArisenKernel.Contracts.IRHIBackend",
        "capabilities": [
          "vulkan"
        ]
      },
      "ArisenEngine.Rendering.IRenderMaterialLibrary",
      "ArisenEngine.Resources.Serialization.IRuntimeSceneService"
    ]
  },
  "subsystems": [
    {
      "class": "PackageGame.ProjectSceneBootstrapSubsystem",
      "phase": "PostInit",
      "priority": 50
    }
  ],
  "dependencies": {
    "com.arisen.core": "1.0.0",
    "com.arisen.ecs": "1.0.0",
    "com.arisen.dag": "1.0.0",
    "com.arisen.taskgraph": "1.0.0",
    "com.arisen.platform.desktop": "1.0.0",
    "com.arisen.rhi.vulkan.native": "1.0.0",
    "com.arisen.resources": "1.0.0",
    "com.arisen.rendering": "1.0.0",
    "com.arisen.generic-renderpipeline": "1.0.0"
  }
}
