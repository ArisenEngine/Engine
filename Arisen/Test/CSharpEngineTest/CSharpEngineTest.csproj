<?xml version='1.0' encoding='utf-8'?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>CSharpEngineTest</AssemblyName>
        <RootNamespace>CSharpEngineTest</RootNamespace>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
<PropertyGroup>
  <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
</PropertyGroup>
<ItemGroup>
      <ProjectReference Include="..\..\Engine\ArisenEngine.csproj" />
</ItemGroup>

<ItemGroup>
    <None Include="..\Assets\**\*.*">
        <Link>Assets\%(RecursiveDir)%(FileName)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\Shader\**\*.*">
        <Link>Shader\%(RecursiveDir)%(FileName)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="ShaderLabRes\**\*.*">
        <Link>ShaderLabRes\%(RecursiveDir)%(FileName)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
</ItemGroup>

<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
<OutputPath>..\..\Projects\VisualStudio\CSharpEngineTest\Outputs\Debug\</OutputPath>
</PropertyGroup>
<PropertyGroup Condition="'$(Configuration)' == 'Release'">
<OutputPath>..\..\Projects\VisualStudio\CSharpEngineTest\Outputs\Release\</OutputPath>
</PropertyGroup>
</Project>