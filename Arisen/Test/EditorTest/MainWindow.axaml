<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dock="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
        xmlns:local="clr-namespace:EditorTest"
        x:Class="EditorTest.MainWindow"
        Title="Dockable System Hot Reload Test" Width="1024" Height="768">
  <Window.DataTemplates>
      <local:EditorTestViewLocator />
  </Window.DataTemplates>
  <Grid>
      <dock:DockControl x:Name="MainDockControl" />
  </Grid>
</Window>
